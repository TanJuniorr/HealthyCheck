        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n  AUTH_USERS ||--o| PROFILES : has\n  AUTH_USERS ||--o{ HEALTH_GOALS : owns\n  AUTH_USERS ||--o{ STEP_RECORDS : records\n  AUTH_USERS ||--o{ SLEEP_RECORDS : records\n  AUTH_USERS ||--o{ SLEEP_SCHEDULES : configures\n  AUTH_USERS ||--o{ MEAL_RECORDS : records\n  AUTH_USERS ||--o{ WATER_RECORDS : records\n  AUTH_USERS ||--o{ WEIGHT_RECORDS : records\n  AUTH_USERS ||--o{ SHARING_INVITES : creates\n  AUTH_USERS ||--o{ APP_NOTIFICATIONS : receives\n  AUTH_USERS ||--o| MENSTRUAL_CYCLE_SETTINGS : configures\n  AUTH_USERS ||--o{ MENSTRUAL_CYCLE_LOGS : records\n  AUTH_USERS ||--o{ AI_CHAT_CONVERSATIONS : owns\n  FOODS ||--o{ MEAL_RECORDS : referenced_by\n  AUTH_USERS {\n    uuid id PK\n  }\n  PROFILES {\n    uuid id PK,FK\n    text full_name\n    date date_of_birth\n    numeric height_cm\n    text gender\n    text avatar_url\n  }\n  HEALTH_GOALS {\n    uuid id PK\n    uuid user_id FK\n    int daily_steps\n    int daily_calories\n    int daily_water_ml\n    int target_sleep_minutes\n  }\n  STEP_RECORDS {\n    uuid id PK\n    uuid user_id FK\n    date record_date\n    int steps\n  }\n  SLEEP_RECORDS {\n    uuid id PK\n    uuid user_id FK\n    timestamptz sleep_start\n    timestamptz sleep_end\n  }\n  FOODS {\n    uuid id PK\n    text name\n    numeric calories_per_100g\n  }\n  MEAL_RECORDS {\n    uuid id PK\n    uuid user_id FK\n    uuid food_id FK\n    text meal_type\n    numeric quantity_g\n    timestamptz consumed_at\n  }\n  WATER_RECORDS {\n    uuid id PK\n    uuid user_id FK\n    int amount_ml\n    timestamptz recorded_at\n  }\n  WEIGHT_RECORDS {\n    uuid id PK\n    uuid user_id FK\n    numeric weight_kg\n    timestamptz recorded_at\n  }\n  SHARING_INVITES {\n    uuid id PK\n    uuid owner_id FK\n    text recipient_email\n    text status\n  }\n  APP_NOTIFICATIONS {\n    uuid id PK\n    uuid recipient_user_id FK\n    text kind\n    timestamptz read_at\n  }\n  MENSTRUAL_CYCLE_SETTINGS {\n    uuid user_id PK,FK\n    date last_period_start\n    int cycle_length\n    int period_length\n  }\n  MENSTRUAL_CYCLE_LOGS {\n    uuid id PK\n    uuid user_id FK\n    date log_date\n    text flow_status\n  }\n  AI_CHAT_CONVERSATIONS {\n    uuid id PK\n    uuid user_id FK\n    jsonb messages\n  }\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="p3sPnvQYrEw1DVF3aVmv-1">
