{
  "expo": {
    "name": "Healthy Check",
    "slug": "HealthyCheck",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "healthycheck",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {}
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nvtan107.HealthyCheck"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-sensors",
        {
          "motionPermission": "Cho phép Healthy Check truy cập chuyển động để đếm bước chân."
        }
      ],
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Healthy Check cần truy cập ảnh để bạn chọn ảnh đại diện và ảnh bài viết.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-notifications",
      "expo-web-browser"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "aa0dba9e-491c-4356-95ce-919f225153fa"
      }
    }
  }
}
